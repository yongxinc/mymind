# ─── MyMind Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── Ollama (Phase 1) ──────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=./chroma_db

# ── Notion API (Phase 2) ──────────────────────────────────────────────────────
# 1. Go to https://www.notion.so/my-integrations
# 2. Click "New integration" → give it a name → copy "Internal Integration Token"
# 3. Open your Notion database → ⋯ menu → Add connections → select your integration
# 4. Copy the database ID from the URL:
#    https://www.notion.so/Your-Title-<DATABASE_ID>?v=...
#    The DATABASE_ID is the part between the last dash and the "?v="
#    Example: notion.so/My-Notes-abc123def456?v=... → DATABASE_ID = abc123def456
#
# Required database properties (will be auto-created if missing):
#   Name (title), Type (select), KB (select), Date (date)

NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Calendar API (Phase 2/3) ───────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or select existing)
# 3. APIs & Services → Library → search "Google Calendar API" → Enable
# 4. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client IDs
#    - Application type: Desktop app
#    - Download the JSON file → rename to "google_credentials.json"
#    - Place it in the backend/ directory
# 5. Start the backend server, then visit:
#    http://localhost:8001/auth/google
#    Authorize in the browser — token is saved automatically.
# 6. To use a specific calendar (not primary), find its ID in:
#    Google Calendar Settings → your calendar → Integrate calendar → Calendar ID

GOOGLE_CREDENTIALS_FILE=./google_credentials.json
GOOGLE_TOKEN_FILE=./google_token.json
GOOGLE_CALENDAR_ID=primary

# ── CORS / OAuth redirect target ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
